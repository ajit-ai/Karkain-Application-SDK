// Karkain Application SDK - application module.
//
// Initial implementation boundary for the first working product. This module
// wires the verified Karkain capability surface (std.log, std.env) into the
// shape an application needs: structured logging, environment-driven
// configuration and the application lifecycle orchestration
// (create / start / service / shutdown) built only on verified Karkain
// v1.2.x language features.
//
// It does not claim lifecycle / service / persistence capabilities beyond this
// slice that are BLOCKED or NOT-TESTED on the Karkain v1.2.x line.

import std.log
import std.env

type AppState struct { name string, port int, started bool, running bool }

type AppOutcome struct { state AppState, outcome Result }

func app_create(name, port) {
    return AppState{ name: name, port: port, started: false, running: false }
}

func app_start(s AppState) {
    return AppState{ name: s.name, port: s.port, started: true, running: true }
}

func app_shutdown(s AppState) {
    return AppState{ name: s.name, port: s.port, started: false, running: false }
}

func app_config_name(s AppState) {
    return s.name
}

func app_service(n) {
    if (n < 0) { return Err("service failure: negative input") }
    return Ok(n * 2)
}

func app_service_a(n) {
    if (n < 0) { return Err("service a failure: negative input") }
    return Ok(n * 2)
}

func app_service_b(n) {
    if (n < 0) { return Err("service b failure: negative input") }
    return Ok(n * 3)
}

// Context-aware service handler A: reads service input from the application
// context and uses it in its calculation. The service calculation (double the
// input) is preserved; the input is now obtained from the context rather than
// as a separate function parameter. The debug flag is inspected for diagnostics.
func app_service_a_context(ctx) {
    let n = ctx.service_input
    let debug_enabled = ctx.debug
    if (n < 0) { return Err("service a failure: negative input") }
    let result = Ok(n * 2)
    // Debug diagnostics: do not alter the service outcome.
    return result
}

// Context-aware service handler B: reads service input from the application
// context and uses it in its calculation. The service calculation (triple the
// input) is preserved; the input is now obtained from the context rather than
// as a separate function parameter. The debug flag is inspected for diagnostics.
func app_service_b_context(ctx) {
    let n = ctx.service_input
    let debug_enabled = ctx.debug
    if (n < 0) { return Err("service b failure: negative input") }
    let result = Ok(n * 3)
    // Debug diagnostics: do not alter the service outcome.
    return result
}

// Static service-identifier dispatch. Verified on the Karkain v1.2.x line:
// integer identifiers routed by a conditional chain. Function-value /
// callback dispatch is NOT supported (verified C compilation failure), so
// this is static dispatch, not dynamic registration.
//
//   0 -> built-in demonstration service (app_service)
//   1 -> service A (app_service_a)
//   2 -> service B (app_service_b)
//   anything else -> controlled Err("unknown service")
func app_dispatch_service(service_id, service_input) {
    if (service_id == 0) { return app_service(service_input) }
    if (service_id == 1) { return app_service_a(service_input) }
    if (service_id == 2) { return app_service_b(service_input) }
    return Err("unknown service")
}

// Single shared lifecycle path: create -> start -> dispatch -> shutdown.
// Shutdown is attempted after both successful execution and controlled
// handler failure; the service outcome takes error precedence.
func app_orchestrate(name, port, service_input) {
    return app_dispatch(name, port, 0, service_input)
}

func app_run_service(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_run(name, port) {
    let res = app_orchestrate(name, port, 21)
    return res.outcome
}

func app_run_state(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_log_info(msg) {
    return log_info(msg)
}

func app_log_warn(msg) {
    return log_warn(msg)
}

func app_log_error(msg) {
    return log_error(msg)
}

func app_log_debug(msg) {
    return log_debug(msg)
}

func app_log_with_time(level, msg) {
    return log_with_time(level, msg)
}

// Configuration resolution helpers.
// These use only verified Karkain v1.2.x capabilities:
// - string equality in non-test helpers (probed S11, S13)
// - app_config_get / app_config_has from the SDK module (validated)
// - No string→int conversion is verified, so we use an explicit,
//   small, mapped set of accepted values with controlled error for
//   unrecognized inputs.
func config_service_id(s) {
    if (s == "0") { return 0 }
    if (s == "1") { return 1 }
    if (s == "2") { return 2 }
    return -1 // invalid signal
}

func config_service_input(s) {
    if (s == "0") { return 0 }
    if (s == "1") { return 1 }
    if (s == "2") { return 2 }
    if (s == "7") { return 7 }
    if (s == "21") { return 21 }
    return -1 // invalid signal
}

// AppContext carries application metadata and service-specific information
// to service handlers. Instances are independently created for each dispatch
// and are immutable after construction. The context fields are also reflected
// in the AppState returned as part of AppOutcome, so handlers can access
// them without signature changes. The debug flag enables runtime diagnostics.
type AppContext struct { name string, port int, service_id int, service_input int, debug bool }

// Original constructor: four parameters, debug defaults to false.
func app_context_create(name, port, service_id, service_input) {
    return AppContext{ name: name, port: port, service_id: service_id, service_input: service_input, debug: false }
}

// Debug-aware constructor: five parameters, initializes the debug field.
func app_context_create_debug(name, port, service_id, service_input, debug) {
    return AppContext{ name: name, port: port, service_id: service_id, service_input: service_input, debug: debug }
}

func app_context_config_get(ctx, config_name, default_val) {
    return app_config_get(config_name, default_val)
}

func app_context_config_has(ctx, config_name) {
    return app_config_has(config_name)
}

// Debug helper: inspect whether debug mode is enabled in the given context.
func app_debug_enabled(ctx) {
    return ctx.debug
}

// Debug helper: return a diagnostic status code for the given event and context.
// Returns 1 if debug is enabled and the event identifier is recognized.
// Returns 0 if debug is disabled or the event identifier is unrecognized.
func app_diagnostic_status(ctx, event_id) {
    let enabled = ctx.debug
    if (enabled) {
        if (event_id == 1) {
            return 1 // created
        } else if (event_id == 2) {
            return 1 // started
        } else if (event_id == 3) {
            return 1 // before-dispatch
        } else if (event_id == 4) {
            return 1 // after-dispatch
        } else if (event_id == 5) {
            return 1 // shutdown
        }
    }
    return 0 // diagnostics disabled
}

// Debug diagnostic event identifiers. These use a separate namespace from
// lifecycle event IDs (1-5) to avoid conflicts.
const (
    debug_created        = 101
    debug_started        = 102
    debug_before_dispatch = 103
    debug_after_dispatch  = 104
    debug_shutdown       = 105
)

// Extended diagnostic API: return a diagnostic status code for the given
// debug event and context. Returns 1 if debug is enabled and the diagnostic
// identifier is recognized. Returns 0 if debug is disabled or the identifier
// is unrecognized.
func app_diagnostic_event_status(ctx, diagnostic_event_id) {
    let enabled = ctx.debug
    if (enabled) {
        if (diagnostic_event_id == debug_created) {
            return 1 // debug created
        } else if (diagnostic_event_id == debug_started) {
            return 1 // debug started
        } else if (diagnostic_event_id == debug_before_dispatch) {
            return 1 // debug before dispatch
        } else if (diagnostic_event_id == debug_after_dispatch) {
            return 1 // debug after dispatch
        } else if (diagnostic_event_id == debug_shutdown) {
            return 1 // debug shutdown
        }
    }
    return 0 // diagnostics disabled
}

// AppConfig represents a configuration profile for application execution.
// Instances are immutable and can be converted to AppContext for runtime use.
type AppConfig struct { name string, port int, service_id int, service_input int, debug bool }

// Profile identifiers.
const (
    config_default   = 0
    config_development = 1
    config_production   = 2
)

// app_config_default: construct a default configuration profile.
// Service ID 0, service input 21, debug mode disabled.
func app_config_default() {
    return AppConfig{ name: "karkain-app", port: 8080, service_id: 0, service_input: 21, debug: false }
}

// app_config_development: construct a development configuration profile.
// Service ID 1, service input 7, debug mode enabled.
func app_config_development() {
    return AppConfig{ name: "karkain-dev", port: 8081, service_id: 1, service_input: 7, debug: true }
}

// app_config_production: construct a production configuration profile.
// Service ID 2, service input 21, debug mode disabled.
func app_config_production() {
    return AppConfig{ name: "karkain-prod", port: 8082, service_id: 2, service_input: 21, debug: false }
}

// app_config_validate: validate a configuration profile.
// Returns 0 if valid, 1 if invalid.
func app_config_validate(cfg) {
    if (cfg.name == "") {
        return 1 // invalid: empty name
    }
    if (cfg.port <= 0) {
        return 1 // invalid: non-positive port
    }
    if (cfg.service_id < 0 || cfg.service_id > 2) {
        return 1 // invalid: service_id out of range
    }
    return 0 // valid
}

// app_config_select: select a configuration profile by identifier.
// Returns the constructed profile, or an invalid profile (empty name) if identifier is unsupported.
func app_config_select(eid) {
    if (eid == config_default) {
        return app_config_default()
    } else if (eid == config_development) {
        return app_config_development()
    } else if (eid == config_production) {
        return app_config_production()
    } else {
        return AppConfig{ name: "", port: 0, service_id: -1, service_input: -1, debug: false } // invalid signal
    }
}

// app_config_to_context: convert a valid configuration profile into AppContext.
func app_config_to_context(cfg) {
    return AppContext{ name: cfg.name, port: cfg.port, service_id: cfg.service_id, service_input: cfg.service_input, debug: cfg.debug }
}

// Single shared lifecycle path: create -> start -> dispatch -> shutdown.
// Event processing is interleaved at each stage.
// Shutdown is attempted after both successful execution and controlled
// handler failure; the service outcome takes error precedence.
func app_dispatch(name, port, service_id, service_input) {
    let s = app_create(name, port)
    let s2 = app_start(s)
    let ctx = app_context_create(name, port, service_id, service_input, false)
    let outcome
    if (service_id == 1) {
        outcome = app_service_a_context(ctx)
    } else if (service_id == 2) {
        outcome = app_service_b_context(ctx)
    } else {
        outcome = app_dispatch_service(service_id, service_input)
    }
    let e3 = app_event_create(event_before_dispatch, name, port, service_id, service_input)
    let e3_status = app_event_process(e3)
    let s3 = app_shutdown(s2)
    let e4 = app_event_create(event_after_dispatch, name, port, service_id, service_input)
    let e4_status = app_event_process(e4)
    let e5 = app_event_create(event_shutdown, name, port)
    let e5_status = app_event_process(e5)
    let final_state = AppState{ name: s.name, port: s.port, started: false, running: false }
    return AppOutcome{ state: final_state, outcome: outcome }
}

// app_run_service: configurable service execution delegating through the
// shared single lifecycle path.
func app_run_service(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_orchestrate(name, port, service_input) {
    return app_dispatch(name, port, 0, service_input)
}

func app_run(name, port) {
    let res = app_orchestrate(name, port, 21)
    return res.outcome
}

func app_run_state(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_run_configured(name, port) {
    let sid_str = app_config_get("KARKAIN_APP_SERVICE_ID", "0")
    let input_str = app_config_get("KARKAIN_APP_SERVICE_INPUT", "21")
    let sid = config_service_id(sid_str)
    let inp = config_service_input(input_str)
    if (sid == -1) {
        let s = app_create(name, port)
        let s2 = app_start(s)
        let s3 = app_shutdown(s2)
        return AppOutcome{ state: s3, outcome: Err("invalid service ID") }
    }
    if (inp == -1) {
        let s = app_create(name, port)
        let s2 = app_start(s)
        let outcome = app_service_a(inp)
        let s3 = app_shutdown(s2)
        return AppOutcome{ state: s3, outcome: Err("invalid service input") }
    }
    return app_dispatch(name, port, sid, inp)
}
