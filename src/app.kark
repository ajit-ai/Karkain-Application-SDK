// Karkain Application SDK - application module.
//
// Initial implementation boundary for the first working product. This module
// wires the verified Karkain capability surface (std.log, std.env) into the
// shape an application needs: structured logging, environment-driven
// configuration and the application lifecycle orchestration
// (create / start / service / shutdown) built only on verified Karkain
// v1.2.x language features.
//
// It does not claim lifecycle / service / persistence capabilities beyond this
// slice that are BLOCKED or NOT-TESTED on the Karkain v1.2.x line.

import std.log
import std.env

type AppState struct { name string, port int, started bool, running bool }

type AppOutcome struct { state AppState, outcome Result }

func app_create(name, port) {
    return AppState{ name: name, port: port, started: false, running: false }
}

func app_start(s AppState) {
    return AppState{ name: s.name, port: s.port, started: true, running: true }
}

func app_shutdown(s AppState) {
    return AppState{ name: s.name, port: s.port, started: false, running: false }
}

func app_config_name(s AppState) {
    return s.name
}

func app_service(n) {
    if (n < 0) { return Err("service failure: negative input") }
    return Ok(n * 2)
}

func app_service_a(n) {
    if (n < 0) { return Err("service a failure: negative input") }
    return Ok(n * 2)
}

func app_service_b(n) {
    if (n < 0) { return Err("service b failure: negative input") }
    return Ok(n * 3)
}

// Static service-identifier dispatch. Verified on the Karkain v1.2.x line:
// integer identifiers routed by a conditional chain. Function-value /
// callback dispatch is NOT supported (verified C compilation failure), so
// this is static dispatch, not dynamic registration.
//
//   0 -> built-in demonstration service (app_service)
//   1 -> service A (app_service_a)
//   2 -> service B (app_service_b)
//   anything else -> controlled Err("unknown service")
func app_dispatch_service(service_id, service_input) {
    if (service_id == 0) { return app_service(service_input) }
    if (service_id == 1) { return app_service_a(service_input) }
    if (service_id == 2) { return app_service_b(service_input) }
    return Err("unknown service")
}

// Single shared lifecycle path: create -> start -> dispatch -> shutdown.
// Shutdown is attempted after both successful execution and controlled
// handler failure; the service outcome takes error precedence.
func app_dispatch(name, port, service_id, service_input) {
    let s = app_create(name, port)
    let s2 = app_start(s)
    let outcome = app_dispatch_service(service_id, service_input)
    let s3 = app_shutdown(s2)
    return AppOutcome{ state: s3, outcome: outcome }
}

func app_orchestrate(name, port, service_input) {
    return app_dispatch(name, port, 0, service_input)
}

func app_run_service(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_run(name, port) {
    let res = app_orchestrate(name, port, 21)
    return res.outcome
}

func app_run_state(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_log_info(msg) {
    return log_info(msg)
}

func app_log_warn(msg) {
    return log_warn(msg)
}

func app_log_error(msg) {
    return log_error(msg)
}

func app_log_debug(msg) {
    return log_debug(msg)
}

func app_log_with_time(level, msg) {
    return log_with_time(level, msg)
}

func app_config_get(name, default_val) {
    return env_get_or(name, default_val)
}

func app_config_has(name) {
    return env_has(name)
}
