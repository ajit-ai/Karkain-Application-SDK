// Karkain Application SDK - focused tests.

func double(x) {
    return x * 2
}

func test_app_math() {
    assert_eq(double(2), 4)
    assert_eq(double(0), 0)
}

func test_app_math_negative() {
    assert_eq(double(-3), -6)
}

// Application SDK orchestration contract tests (self-contained unit).

type AppState struct { name string, port int, started bool }

type AppOutcome struct { state AppState, outcome Result }

func app_create(name, port) {
    return AppState{ name: name, port: port, started: false }
}

func app_start(s AppState) {
    return AppState{ name: s.name, port: s.port, started: true }
}

func app_shutdown(s AppState) {
    return AppState{ name: s.name, port: s.port, started: false }
}

func app_service(n) {
    if (n < 0) { return Err("service failure: negative input") }
    return Ok(n * 2)
}

func app_orchestrate(name, port, service_input) {
    let s = app_create(name, port)
    let s2 = app_start(s)
    let outcome = app_service(service_input)
    let s3 = app_shutdown(s2)
    return AppOutcome{ state: s3, outcome: outcome }
}

func app_run(name, port) {
    let res = app_orchestrate(name, port, 21)
    return res.outcome
}

func test_app_orchestrate_success() {
    let res = app_orchestrate("kapp", 8080, 21)
    let st = res.state
    let out = res.outcome
    let v = out?
    assert_eq(v, 42)
    assert(st.started == false)
}

func test_app_orchestrate_failure_shutdown() {
    let res = app_orchestrate("kapp", 8080, -5)
    let st = res.state
    assert(st.started == false)
}

func test_app_run_backcompat() {
    let out = app_run("kapp", 8080)
    let v = out?
    assert_eq(v, 42)
}
