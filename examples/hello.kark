// Karkain Application SDK - first working product example.

// A native Karkain application that orchestrates the verified lifecycle
// (create -> start -> service -> shutdown) through app_run_service with a
// caller-controlled service input, inspects the final outcome and state, and
// handles the outcome.

import std.log

type AppState struct { name string, port int, started bool, running bool }

type AppOutcome struct { state AppState, outcome Result }

func app_create(name, port) {
    return AppState{ name: name, port: port, started: false, running: false }
}

func app_start(s AppState) {
    return AppState{ name: s.name, port: s.port, started: true, running: true }
}

func app_shutdown(s AppState) {
    return AppState{ name: s.name, port: s.port, started: false, running: false }
}

func app_service(n) {
    if (n < 0) { return Err("service failure: negative input") }
    return Ok(n * 2)
}

func app_run_service(name, port, service_input) {
    let s = app_create(name, port)
    let s2 = app_start(s)
    let outcome = app_service(service_input)
    let s3 = app_shutdown(s2)
    return AppOutcome{ state: s3, outcome: outcome }
}

func app_log_info(msg) {
    return log_info(msg)
}

func app_log_error(msg) {
    return log_error(msg)
}

func main() {
    let res = app_run_service("karkain-app", 8080, 7)
    let out = res.outcome
    let st = res.state
    println(st.started)
    match out {
        Ok(v) => { app_log_info("application service completed") },
        Err(e) => { app_log_error(e) },
    }
}
