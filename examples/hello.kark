// Karkain Application SDK - first working product example.

// A native Karkain application that orchestrates the verified lifecycle
// (create -> start -> service -> shutdown) through app_run and handles the
// final outcome.

import std.log

type AppState struct { name string, port int, started bool }

func app_create(name, port) {
    return AppState{ name: name, port: port, started: false }
}

func app_start(s AppState) {
    return AppState{ name: s.name, port: s.port, started: true }
}

func app_shutdown(s AppState) {
    return AppState{ name: s.name, port: s.port, started: false }
}

func app_service(n) {
    if (n < 0) { return Err("service failure: negative input") }
    return Ok(n * 2)
}

func app_log_info(msg) {
    return log_info(msg)
}

func app_log_error(msg) {
    return log_error(msg)
}

func app_run(name, port) {
    let s = app_create(name, port)
    let s2 = app_start(s)
    let outcome = app_service(21)
    let s3 = app_shutdown(s2)
    return outcome
}

func main() {
    let outcome = app_run("karkain-app", 8080)
    match outcome {
        Ok(v) => { app_log_info("application service completed") },
        Err(e) => { app_log_error(e) },
    }
}
