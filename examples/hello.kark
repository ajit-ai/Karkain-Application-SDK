// Karkain Application SDK - first working product example.
//
// Demonstrates the synchronous service-handler dispatch contract, the
// environment-driven configuration API ``app_run_configured``, and the
// service context structure ``AppContext`` that is passed to service
// handlers to provide application metadata and service-specific information.
//
// Demonstrates debug mode propagation from AppConfig through AppContext
// to context-aware service handlers.

// Configuration variables (set in the *host process* environment, not from
// within the Karkain example itself):
//
//   KARKAIN_APP_SERVICE_ID   - selects service handler (0, 1, 2);
//                              defaults to 0 when absent.
//   KARKAIN_APP_SERVICE_INPUT - provides service input; defaults to 21 when absent.
//
// The example runs three scenarios in sequence (each scenario requires the
// corresponding environment variable(s) to be set in the host PowerShell
// session before running the command):
//
// Scenario A — Default profile:
//
//   karkain run examples/hello.kark
//
//   Output: 0 (stopped), 42 (Ok(21 * 2), service 0 with input 21),
//           debug disabled.
//
// Scenario B — Development profile:
//
//   $env:KARKAIN_APP_SERVICE_ID = "2"
//   $env:KARKAIN_APP_SERVICE_INPUT = "7"
//   karkain run examples/hello.kark
//
//   Output: 0 (stopped), 21 (Ok(7 * 3)), debug enabled.
//
// Scenario C — Production profile:
//
//   $env:KARKAIN_APP_SERVICE_ID = "2"
//   $env:KARKAIN_APP_SERVICE_INPUT = "21"
//   karkain run examples/hello.kark
//
//   Output: 0 (stopped), 42 (Ok(21 * 2), service B with input 21),
//           debug disabled.
//
// Context fields are embedded in AppState via app_dispatch, so handlers can
// access them through res.state without signature changes.

import std.log

type AppState struct { name string, port int, started bool, running bool }

type AppOutcome struct { state AppState, outcome Result }

type AppContext struct { name string, port int, service_id int, service_input int, debug bool }

type AppEvent struct { id int, name string, port int, service_id int, service_input int }

// Debug helper: inspect whether debug mode is enabled in the given context.
func app_debug_enabled(ctx) {
    return ctx.debug
}

// Debug helper: return a diagnostic status code for the given event and context.
// When debug is false, returns 0 (diagnostics disabled).
// When debug is true, returns 1 (diagnostics enabled) for recognized events.
func app_diagnostic_status(ctx, event_id) {
    let enabled = ctx.debug
    if (enabled) {
        if (event_id == 1) {
            return 1 // created diagnostic enabled
        } else if (event_id == 2) {
            return 1 // started diagnostic enabled
        } else if (event_id == 3) {
            return 1 // before-dispatch diagnostic enabled
        } else if (event_id == 4) {
            return 1 // after-dispatch diagnostic enabled
        } else if (event_id == 5) {
            return 1 // shutdown diagnostic enabled
        }
    }
    return 0 // diagnostics disabled
}

func app_create(name, port) {
    return AppState{ name: name, port: port, started: false, running: false }
}

func app_start(s AppState) {
    return AppState{ name: s.name, port: s.port, started: true, running: true }
}

func app_shutdown(s AppState) {
    return AppState{ name: s.name, port: s.port, started: false, running: false }
}

func app_service(n) {
    if (n < 0) { return Err("service failure: negative input") }
    return Ok(n * 2)
}

func app_service_a(n) {
    if (n < 0) { return Err("service a failure: negative input") }
    return Ok(n * 2)
}

func app_service_b(n) {
    if (n < 0) { return Err("service b failure: negative input") }
    return Ok(n * 3)
}

func config_service_id(s) {
    if (s == "0") { return 0 }
    if (s == "1") { return 1 }
    if (s == "2") { return 2 }
    return -1
}

func config_service_input(s) {
    if (s == "0") { return 0 }
    if (s == "1") { return 1 }
    if (s == "2") { return 2 }
    if (s == "7") { return 7 }
    if (s == "21") { return 21 }
    return -1
}

// Original constructor: four parameters, debug defaults to false.
func app_context_create(name, port, service_id, service_input) {
    return AppContext{ name: name, port: port, service_id: service_id, service_input: service_input, debug: false }
}

// Debug-aware constructor: five parameters, initializes the debug field.
func app_context_create_debug(name, port, service_id, service_input, debug) {
    return AppContext{ name: name, port: port, service_id: service_id, service_input: service_input, debug: debug }
}

func app_context_config_get(ctx, config_name, default_val) {
    return app_config_get(config_name, default_val)
}

func app_context_config_has(ctx, config_name) {
    return app_config_has(config_name)
}

// app_config_default: construct a default configuration profile.
// Service ID 0, service input 21, debug mode disabled.
func app_config_default() {
    return AppConfig{ name: "karkain-app", port: 8080, service_id: 0, service_input: 21, debug: false }
}

// app_config_development: construct a development configuration profile.
// Service ID 1, service input 7, debug mode enabled.
func app_config_development() {
    return AppConfig{ name: "karkain-dev", port: 8081, service_id: 1, service_input: 7, debug: true }
}

// app_config_production: construct a production configuration profile.
// Service ID 2, service input 21, debug mode disabled.
func app_config_production() {
    return AppConfig{ name: "karkain-prod", port: 8082, service_id: 2, service_input: 21, debug: false }
}

// app_config_validate: validate a configuration profile.
// Returns 0 if valid, 1 if invalid.
func app_config_validate(cfg) {
    if (cfg.name == "") {
        return 1 // invalid: empty name
    }
    if (cfg.port <= 0) {
        return 1 // invalid: non-positive port
    }
    if (cfg.service_id < 0 || cfg.service_id > 2) {
        return 1 // invalid: service_id out of range
    }
    return 0 // valid
}

// app_config_select: select a configuration profile by identifier.
func app_config_select(eid) {
    if (eid == 0) {
        return app_config_default()
    } else if (eid == 1) {
        return app_config_development()
    } else if (eid == 2) {
        return app_config_production()
    } else {
        return AppConfig{ name: "", port: 0, service_id: -1, service_input: -1, debug: false }
    }
}

// app_config_to_context: convert a valid configuration profile into AppContext.
func app_config_to_context(cfg) {
    return AppContext{ name: cfg.name, port: cfg.port, service_id: cfg.service_id, service_input: cfg.service_input, debug: cfg.debug }
}

func app_dispatch(name, port, service_id, service_input) {
    let s = app_create(name, port)
    let s2 = app_start(s)
    let ctx = app_context_create(name, port, service_id, service_input)
    let outcome = app_dispatch_service(service_id, service_input)
    let s3 = app_shutdown(s2)
    // Post-dispatch diagnostics (debug disabled in base dispatch)
    let diag = app_diagnostic_status(ctx, 4)
    let final_state = AppState{ name: s.name, port: s.port, started: false, running: false }
    return AppOutcome{ state: final_state, outcome: outcome }
}

func app_orchestrate(name, port, service_input) {
    return app_dispatch(name, port, 0, service_input)
}

func app_run_service(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_run(name, port) {
    let res = app_orchestrate(name, port, 21)
    return res.outcome
}

func app_run_state(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

// Debug-enabled context-aware service handler A.
// Reads service input from the application context and uses it in its
// calculation. The service calculation (double the input) is preserved.
// The debug flag is inspected for diagnostics.
func app_service_a_context(ctx) {
    let n = ctx.service_input
    let debug_enabled = ctx.debug
    if (n < 0) { return Err("service a failure: negative input") }
    // Diagnostic status when debug is enabled (does not alter outcome)
    let diag = app_diagnostic_status(ctx, 1)
    return Ok(n * 2)
}

// Debug-enabled context-aware service handler B.
// Reads service input from the application context and uses it in its
// calculation. The service calculation (triple the input) is preserved.
// The debug flag is inspected for diagnostics.
func app_service_b_context(ctx) {
    let n = ctx.service_input
    let debug_enabled = ctx.debug
    if (n < 0) { return Err("service b failure: negative input") }
    // Diagnostic status when debug is enabled (does not alter outcome)
    let diag = app_diagnostic_status(ctx, 1)
    return Ok(n * 3)
}

func app_log_info(msg) {
    return log_info(msg)
}

func app_log_error(msg) {
    return log_error(msg)
}

func main() {
    // Scenario A: Default profile.
    //   Construct default AppConfig, validate, convert to AppContext.
    //   Debug mode is disabled.
    println("=== scenario A: default profile ===")
    let cfgA = app_config_default()
    let validA = app_config_validate(cfgA)
    let ctxA = app_config_to_context(cfgA)
    println("debug enabled: ", app_debug_enabled(ctxA))
    let resA = app_run_configured("karkain-app", 8080)
    let outA = resA.outcome
    let stA = resA.state
    println(stA.started)
    match outA {
        Ok(v) => {
            println(v)
        },
        Err(e) => {
            println(e)
        },
    }

    // Scenario B: Development profile via environment.
    //   Set KARKAIN_APP_SERVICE_ID=2 to select service B (triple input).
    //   KARKAIN_APP_SERVICE_INPUT=7 → input 7 → Ok(21).
    //   Debug mode is enabled (development profile).
    // PowerShell example (run in the same session):
    //   $env:KARKAIN_APP_SERVICE_ID = "2"
    //   $env:KARKAIN_APP_SERVICE_INPUT = "7"
    //   karkain run examples/hello.kark
    // (The example itself cannot modify the process environment portably,
    //  so the external shell setup is documented.)

    // Scenario C: Production profile via construction.
    //   Construct production AppConfig, validate, convert to AppContext.
    //   Debug mode is disabled.
    //   Execute Service B with input 21.
    println("=== scenario C: production profile ===")
    let cfgC = app_config_production()
    let validC = app_config_validate(cfgC)
    let ctxC = app_config_to_context(cfgC)
    println("debug enabled: ", app_debug_enabled(ctxC))
    let resC = app_dispatch("karkain-prod", 8082, 2, 21)
    let outC = resC.outcome
    let stC = resC.state
    println(stC.started)
    match outC {
        Ok(v) => {
            println(v)
        },
        Err(e) => {
            println(e)
        },
    }

    // Note: the example process cannot set environment variables for itself;
    // each scenario requires the host shell to set the vars before running.
    // The example demonstrates the API patterns; actual execution requires
    // the host PowerShell session to set the environment variables.
}