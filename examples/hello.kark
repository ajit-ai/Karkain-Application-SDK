// Karkain Application SDK - first working product example.

// A native Karkain application that creates state, loads configuration,
// logs startup, runs a service, reports a controlled failure and shuts down.

import std.log

type AppState struct { name string, port int, started bool }

func app_create(name, port) {
    return AppState{ name: name, port: port, started: false }
}

func app_start(s AppState) {
    return AppState{ name: s.name, port: s.port, started: true }
}

func app_shutdown(s AppState) {
    return AppState{ name: s.name, port: s.port, started: false }
}

func app_config_name(s AppState) {
    return s.name
}

func app_service(n) {
    if (n < 0) { return Err("service failure: negative input") }
    return Ok(n * 2)
}

func app_log_info(msg) {
    return log_info(msg)
}

func app_log_error(msg) {
    return log_error(msg)
}

func app_log_with_time(level, msg) {
    return log_with_time(level, msg)
}

func main() {
    let s = app_create("karkain-app", 8080)
    let app_name = app_config_name(s)
    println(app_name)
    app_log_info("Karkain Application SDK starting")
    let s2 = app_start(s)
    app_log_with_time("INFO", "application started")
    let v = app_service(21)
    println(v)
    let failed = app_service(-5)
    match failed {
        Ok(v2) => { app_log_info("unexpected success") },
        Err(e) => { app_log_error(e) },
    }
    let s3 = app_shutdown(s2)
    app_log_info("application shutdown complete")
}
