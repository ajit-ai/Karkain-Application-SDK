// Karkain Application SDK - first working product example.
//
// Demonstrates the synchronous service-handler dispatch contract, the
// environment-driven configuration API ``app_run_configured``, and the
// service context structure ``AppContext`` that is passed to service
// handlers to provide application metadata and service-specific information.
//
// Demonstrates lifecycle events: created → started → before-dispatch →
// after-dispatch → shutdown. Dispatch is static (integer identifiers
// routed by a conditional chain); it is not dynamic registration.
//
// Configuration variables (set in the *host process* environment, not from
// within the Karkain example itself):
//
//   KARKAIN_APP_SERVICE_ID   - selects service handler (0, 1, 2);
//                              defaults to 0 when absent.
//   KARKAIN_APP_SERVICE_INPUT - provides service input; defaults to 21 when absent.
//
// The example runs three scenarios in sequence (each scenario requires the
// corresponding environment variable(s) to be set in the host PowerShell
// session before running the command):
//
// Scenario 1 — default configuration (no env vars set):
//
//   karkain run examples/hello.kark
//
//   Output: 0 (stopped), 42 (Ok(21 * 2), service 0 with input 21),
//           lifecycle events: created(1), started(2), after-dispatch(4),
//           shutdown(5).
//
// Scenario 2 — explicit service selection:
//
//   $env:KARKAIN_APP_SERVICE_ID = "2"
//   $env:KARKAIN_APP_SERVICE_INPUT = "7"
//   karkain run examples/hello.kark
//
//   Output: 0 (stopped), 21 (Ok(7 * 3)), lifecycle events as above.
//
// Scenario 3 — invalid configuration:
//
//   $env:KARKAIN_APP_SERVICE_ID = "99"
//   karkain run examples/hello.kark
//
//   Output: 0 (stopped), [ERROR] invalid service ID, lifecycle events as above.
//
// Context fields are embedded in AppState via app_dispatch, so handlers can
// access them through res.state without signature changes.

import std.log

type AppState struct { name string, port int, started bool, running bool }

type AppOutcome struct { state AppState, outcome Result }

type AppContext struct { name string, port int, service_id int, service_input int }

type AppEvent struct { id int, name string, port int, service_id int, service_input int }

func app_event_create(eid, name, port) {
    return AppEvent{ id: eid, name: name, port: port }
}

func app_event_id(e) {
    return e.id
}

func app_event_name(e) {
    return e.name
}

func app_event_port(e) {
    return e.port
}

func app_event_service_id(e) {
    return e.service_id
}

func app_event_service_input(e) {
    return e.service_input
}

const (
    event_created     = 1
    event_started     = 2
    event_before_dispatch = 3
    event_after_dispatch = 4
    event_shutdown    = 5
)

func app_event_process(e) {
    let i = e.id
    if (i == event_created) {
        return 1 // application created
    } else if (i == event_started) {
        return 2 // application started
    } else if (i == event_before_dispatch) {
        return 3 // before service dispatch
    } else if (i == event_after_dispatch) {
        return 4 // after service dispatch
    } else if (i == event_shutdown) {
        return 5 // application shutdown
    }
    return 0 // unknown event
}

func app_create(name, port) {
    return AppState{ name: name, port: port, started: false, running: false }
}

func app_start(s AppState) {
    return AppState{ name: s.name, port: s.port, started: true, running: true }
}

func app_shutdown(s AppState) {
    return AppState{ name: s.name, port: s.port, started: false, running: false }
}

func app_service(n) {
    if (n < 0) { return Err("service failure: negative input") }
    return Ok(n * 2)
}

func app_service_a(n) {
    if (n < 0) { return Err("service a failure: negative input") }
    return Ok(n * 2)
}

func app_service_b(n) {
    if (n < 0) { return Err("service b failure: negative input") }
    return Ok(n * 3)
}

func config_service_id(s) {
    if (s == "0") { return 0 }
    if (s == "1") { return 1 }
    if (s == "2") { return 2 }
    return -1
}

func config_service_input(s) {
    if (s == "0") { return 0 }
    if (s == "1") { return 1 }
    if (s == "2") { return 2 }
    if (s == "7") { return 7 }
    if (s == "21") { return 21 }
    return -1
}

func app_context_create(name, port, service_id, service_input) {
    return AppContext{ name: name, port: port, service_id: service_id, service_input: service_input }
}

func app_context_config_get(ctx, config_name, default_val) {
    return app_config_get(config_name, default_val)
}

func app_context_config_has(ctx, config_name) {
    return app_config_has(config_name)
}

func app_dispatch(name, port, service_id, service_input) {
    let s = app_create(name, port)
    let e1 = app_event_create(event_created, name, port)
    let e1_status = app_event_process(e1)
    let s2 = app_start(s)
    let e2 = app_event_create(event_started, name, port)
    let e2_status = app_event_process(e2)
    let outcome
    if (service_id == 1) {
        outcome = app_service_a_context(/* context */)
    } else if (service_id == 2) {
        outcome = app_service_b_context(/* context */)
    } else {
        outcome = app_dispatch_service(service_id, service_input)
    }
    let e3 = app_event_create(event_before_dispatch, name, port, service_id, service_input)
    let e3_status = app_event_process(e3)
    let s3 = app_shutdown(s)
    let e4 = app_event_create(event_after_dispatch, name, port, service_id, service_input)
    let e4_status = app_event_process(e4)
    let e5 = app_event_create(event_shutdown, name, port)
    let e5_status = app_event_process(e5)
    let final_state = AppState{ name: s.name, port: s.port, started: false, running: false }
    return AppOutcome{ state: final_state, outcome: outcome }
}

func app_orchestrate(name, port, service_input) {
    return app_dispatch(name, port, 0, service_input)
}

func app_run_service(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_run(name, port) {
    let res = app_orchestrate(name, port, 21)
    return res.outcome
}

func app_run_state(name, port, service_input) {
    return app_orchestrate(name, port, service_input)
}

func app_run_configured(name, port) {
    let sid_str = app_config_get("KARKAIN_APP_SERVICE_ID", "0")
    let input_str = app_config_get("KARKAIN_APP_SERVICE_INPUT", "21")
    let sid = config_service_id(sid_str)
    let inp = config_service_input(input_str)
    if (sid == -1) {
        let s = app_create(name, port)
        let s2 = app_start(s)
        let s3 = app_shutdown(s2)
        return AppOutcome{ state: s3, outcome: Err("invalid service ID") }
    }
    if (inp == -1) {
        let s = app_create(name, port)
        let s2 = app_start(s)
        let outcome = app_service_a(inp)
        let s3 = app_shutdown(s2)
        return AppOutcome{ state: s3, outcome: Err("invalid service input") }
    }
    return app_dispatch(name, port, sid, inp)
}

func app_log_info(msg) {
    return log_info(msg)
}

func app_log_error(msg) {
    return log_error(msg)
}

func main() {
    // Scenario 1: default configuration (no env vars set).
    //   KARKAIN_APP_SERVICE_ID absent → 0 (built-in demonstration service).
    //   KARKAIN_APP_SERVICE_INPUT absent → 21.
    println("=== scenario 1: default configuration ===")
    let res1 = app_run_configured("karkain-app", 8080)
    let out1 = res1.outcome
    let st1 = res1.state
    println(st1.started)
    match out1 {
        Ok(v) => {
            println(v)
        },
        Err(e) => {
            println(e)
        },
    }

    // Scenario 2: explicit service selection via environment.
    //   Set KARKAIN_APP_SERVICE_ID=2 to select service B (triple input).
    //   KARKAIN_APP_SERVICE_INPUT=7 → input 7 → Ok(21).
    // PowerShell example (run in the same session):
    //   $env:KARKAIN_APP_SERVICE_ID = "2"
    //   $env:KARKAIN_APP_SERVICE_INPUT = "7"
    //   karkain run examples/hello.kark
    // (The example itself cannot modify the process environment portably,
    //  so the external shell setup is documented.)

    // Scenario 3: invalid service ID.
    //   KARKAIN_APP_SERVICE_ID=99 is not a recognized identifier.
    //   Controlled error is returned; application still stops.
    // PowerShell example:
    //   $env:KARKAIN_APP_SERVICE_ID = "99"
    //   karkain run examples/hello.kark

    // Note: the example process cannot set environment variables for itself;
    // each scenario requires the host shell to set the vars before running.
}